# LLM provider: "gemini" (hosted, default) or "ollama" (local, fully offline).
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Custom Search JSON API — free tier, 100 queries/day (shared globally
# across everyone who uses the deployed app). Leave blank to run without it;
# the agent just skips the Google tool and uses GitHub + HackerNews only.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

ADMIN_USERNAME=
ADMIN_PASSWORD=
