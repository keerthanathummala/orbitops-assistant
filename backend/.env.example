# LLM provider: "gemini" (hosted, default) or "ollama" (local, fully offline).
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The admin account, created when the backend starts. Sign in with these to
# open the admin page (who used the app, when, from which IP; never chats).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Custom Search JSON API — free tier, 100 queries/day (shared globally
# across everyone who uses the deployed app). Leave blank to run without it;
# the agent just skips the Google tool and uses GitHub + HackerNews only.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
